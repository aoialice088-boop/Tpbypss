-- TP Phantom++ (ultra bypass)
local function teleportPhantomPlus(targetPos)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    
    local startPos = hrp.Position
    local distance = (targetPos - startPos).Magnitude
    
    stepSize = tonumber(stepSizeInput.Text) or 0.3
    local steps = math.max(5, math.floor(distance / stepSize))
    
    statusLabel.Text = "👻 Phantom++ TP...\nDistância: " .. string.format("%.1f", distance) .. " studs"
    statusLabel.TextColor3 = Color3.fromRGB(200, 100, 255)
    
    -- Desativa física completamente
    local originalAnchored = hrp.Anchored
    local originalPlatformStand = humanoid.PlatformStand
    hrp.Anchored = true
    humanoid.PlatformStand = true
    
    -- Remove NetworkOwnership do servidor
    pcall(function() hrp:SetNetworkOwner(nil) end)
    task.wait(0.1)
    
    -- Move em micro-steps ultra-lentos
    for i = 1, steps do
        local progress = i / steps
        local currentPos = startPos:Lerp(targetPos, progress)
        hrp.CFrame = CFrame.new(currentPos)
        task.wait(0.05) -- 50ms entre cada step (mais lento = menos detectável)
    end
    
    hrp.CFrame = CFrame.new(targetPos)
    
    -- Restaura NetworkOwnership
    pcall(function() hrp:SetNetworkOwner(player) end)
    task.wait(0.1)
    
    -- Restaura física
    hrp.Anchored = originalAnchored
    humanoid.PlatformStand = originalPlatformStand
    
    -- Auto delay antes de interagir com itens
    if autoDelayEnabled then
        statusLabel.Text = "⏳ Aguardando 1.5s antes de interagir...\nAnti-detect ativo"
        task.wait(1.5)
    end
    
    statusLabel.Text = "✅ Phantom++ completo\nBypass: SUCESSO"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
end

-- TP Ghost Pro
local function teleportGhostPro(targetPos)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    statusLabel.Text = "🌐 Ghost Pro TP...\nSpoofing network..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    
    -- Remove ownership
    pcall(function() hrp:SetNetworkOwner(nil) end)
    task.wait(0.15)
    
    -- Teleporta
    hrp.CFrame = CFrame.new(targetPos)
    task.wait(0.2)
    
    -- Restaura ownership
    pcall(function() hrp:SetNetworkOwner(player) end)
    
    if autoDelayEnabled then
        statusLabel.Text = "⏳ Delay anti-detect..."
        task.wait(1.5)
    end
    
    statusLabel.Text = "✅ Ghost Pro completo"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
end

-- TP Walk Sim (simula caminhada)
local function teleportWalkSim(targetPos)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    
    local startPos = hrp.Position
    local distance = (targetPos - startPos).Magnitude
    
    statusLabel.Text = "🚶 Walk Sim TP...\nSimulando caminhada..."
    statusLabel.TextColor3 = Color3.fromRGB(60, 200, 255)
    
    -- Simula velocidade de caminhada
    local walkSpeed = 16
    local timeNeeded = distance / walkSpeed
    
    -- Move suavemente simulando caminhada
    local startTime = tick()
    while tick() - startTime < timeNeeded do
        local progress = (tick() - startTime) / timeNeeded
        local currentPos = startPos:Lerp(targetPos, progress)
        hrp.CFrame = CFrame.new(currentPos)
        task.wait(0.1)
    end
    
    hrp.CFrame = CFrame.new(targetPos)
    
    if autoDelayEnabled then
        task.wait(1.5)
    end
    
    statusLabel.Text = "✅ Walk Sim completo\nIndetectável"
    statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
end

tpBtn.MouseButton1Click:Connect(function()
    if not selectedWaypoint or not waypoints[selectedWaypoint] then
        statusLabel.Text = "❌ Selecione um waypoint"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local targetPos = waypoints[selectedWaypoint].pos
    
    if currentMode == "Phantom++" then
        teleportPhantomPlus(targetPos)
    elseif currentMode == "Ghost" then
        teleportGhostPro(targetPos)
    elseif currentMode == "Walk" then
        teleportWalkSim(targetPos)
    end
end)

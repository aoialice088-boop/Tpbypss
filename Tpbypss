-- Draggable
local dragging, dragInput, dragStart, startPos
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- Sistema de Waypoints
local waypoints = {}
local selectedWaypoint = nil
local currentMode = "Phantom++"
local autoDelayEnabled = true
local stepSize = 0.3

local function updateList()
    for _, child in pairs(scrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    for i, wp in ipairs(waypoints) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = selectedWaypoint == i and Color3.fromRGB(60, 120, 255) or Color3.fromRGB(50, 50, 70)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = wp.name .. " (" .. math.floor(wp.pos.X) .. ", " .. math.floor(wp.pos.Y) .. ", " .. math.floor(wp.pos.Z) .. ")"
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.BorderSizePixel = 0
        btn.LayoutOrder = i
        btn.Parent = scrollFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        btn.MouseButton1Click:Connect(function()
            selectedWaypoint = i
            updateList()
        end)
        
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.new(0, 24, 0, 24)
        delBtn.Position = UDim2.new(1, -28, 0.5, -12)
        delBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        delBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        delBtn.Text = "X"
        delBtn.Font = Enum.Font.GothamBold
        delBtn.TextSize = 12
        delBtn.BorderSizePixel = 0
        delBtn.Parent = btn
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 4)
        
        delBtn.MouseButton1Click:Connect(function()
            table.remove(waypoints, i)
            if selectedWaypoint == i then selectedWaypoint = nil end
            updateList()
        end)
    end
end

